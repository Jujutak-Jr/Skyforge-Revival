rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Benutzername-Reservierung: Dokument-ID = Benutzername (slug).
    // "create" gilt in Firestore-Regeln nur, wenn das Dokument noch NICHT existiert,
    // dadurch ist ein Benutzername automatisch nur einmal vergebbar.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // Öffentliches Profil pro Account (uid = Firebase-Auth-User-ID)
    match /accounts/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Forum: Threads sind für alle lesbar, nur eingeloggte Nutzer dürfen
    // welche erstellen (und nur unter ihrer eigenen uid). Kein Bearbeiten/
    // Löschen über die App - Moderation läuft manuell über die Firebase Console.
    match /forumThreads/{threadId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 4000;
      allow update, delete: if false;

      // Antworten auf einen Thread, gleiches Prinzip.
      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
